# Copy to .env and fill in. Never commit .env.

# Which provider to use by default: "mock" (offline, no key) or "gemini".
IPT_PROVIDER=mock

# Google Gemini API key (https://aistudio.google.com/apikey). Only needed for --provider gemini.
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated Gemini models, tried in order (fallback on error).
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Max concurrent model requests.
IPT_CONCURRENCY=4
